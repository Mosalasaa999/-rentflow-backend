datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum LeaseStatus {
  ACTIVE
  PAUSED
  TERMINATED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  PARTIAL
  REFUNDED
  DISPUTED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  BANK_TRANSFER
  CASH
}

enum ActorType {
  SYSTEM
  LANDLORD
  TENANT
  ADMIN
}

enum ProviderType {
  STRIPE
  TWILIO
  PLAID
}

model Landlord {
  id              String    @id @default(uuid()) @db.Uuid
  name            String
  email           String    @unique
  phoneNumber     String?
  payoutAccountId String
  country         String    @db.VarChar(2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  leases Lease[]
}

model Tenant {
  id                       String    @id @default(uuid()) @db.Uuid
  name                     String
  phoneNumber              String    @unique
  email                    String?
  nationalId               String?
  bankAccessToken          String
  bankAccessTokenExpiresAt DateTime
  creditScoreOptIn         Boolean   @default(false)
  creditScoreCurrent       Int?
  preferredLocale          String    @default("en")
  whatsappOptIn            Boolean   @default(true)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  leases Lease[]
}

model Lease {
  id                     String      @id @default(uuid()) @db.Uuid
  landlordId             String      @db.Uuid
  tenantId               String      @db.Uuid
  rentAmount             Decimal     @db.Decimal(12, 2)
  currency               String      @db.VarChar(3)
  dueDayOfMonth          Int
  gracePeriodDays        Int         @default(2)
  lateFeePercentage      Decimal     @default(0) @db.Decimal(5, 2)
  startDate              DateTime
  endDate                DateTime
  status                 LeaseStatus @default(ACTIVE)
  reminderHoursBeforeDue Int         @default(48)
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  deletedAt              DateTime?

  landlord       Landlord        @relation(fields: [landlordId], references: [id])
  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  paymentRecords PaymentRecord[]

  @@index([landlordId, status])
  @@index([tenantId, status])
}

model PaymentRecord {
  id                     String        @id @default(uuid()) @db.Uuid
  leaseId                String        @db.Uuid
  amount                 Decimal       @db.Decimal(12, 2)
  currency               String        @db.VarChar(3)
  status                 PaymentStatus @default(PENDING)
  paymentDate            DateTime?
  dueDate                DateTime
  stripeSessionId        String?       @unique
  stripePaymentIntentId  String?
  paymentMethod          PaymentMethod?
  reportedToCreditBureau Boolean       @default(false)
  reportedAt             DateTime?
  failureReason          String?
  idempotencyKey         String        @unique
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  lease Lease @relation(fields: [leaseId], references: [id])

  @@index([leaseId, status])
  @@index([dueDate, status])
}

model AuditLog {
  id         String    @id @default(uuid()) @db.Uuid
  actorType  ActorType
  actorId    String?   @db.Uuid
  action     String
  entityType String
  entityId   String    @db.Uuid
  metadata   Json      @default("{}")
  ipAddress  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

model WebhookEvent {
  id              String       @id @default(uuid()) @db.Uuid
  provider        ProviderType
  externalEventId String       @unique
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
}
